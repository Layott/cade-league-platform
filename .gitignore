# Brand asset zip archives — extracted contents live alongside
KNOWLEDGE/brand-assets/fonts/*.zip

# Futbin live-price scraper — state + cookies + unmatched dump (regenerated per run)
KNOWLEDGE/extracted/_scrape_tmp/
KNOWLEDGE/extracted/_scrape_logs/
KNOWLEDGE/extracted/futbin_scrape_state.json
KNOWLEDGE/extracted/futbin_unmatched.json

# Futbin cookie-injected scraper — cf_clearance secrets + per-run artefacts
KNOWLEDGE/extracted/.futbin_cookies.json
KNOWLEDGE/extracted/futbin_cookies_state.json
KNOWLEDGE/extracted/futbin_cookies_unmatched.json
KNOWLEDGE/extracted/futbin_cookies_inserted.json

# Headful + reverse + range scrapers — persistent Chromium profiles + per-run state
KNOWLEDGE/extracted/.futbin_chromium_profile/
KNOWLEDGE/extracted/.futbin_chromium_profile_reverse/
KNOWLEDGE/extracted/futbin_headful_state.json
KNOWLEDGE/extracted/futbin_headful_inserted.json
KNOWLEDGE/extracted/futbin_headful_unmatched.json
KNOWLEDGE/extracted/futbin_reverse_state.json

# Futbin/futgg/futwiz probe/dump artefacts
KNOWLEDGE/extracted/futbin_*.html
KNOWLEDGE/extracted/futbin_*.png
KNOWLEDGE/extracted/futgg_*.html
KNOWLEDGE/extracted/futwiz_*.html
KNOWLEDGE/extracted/futwiz_unmatched.json
KNOWLEDGE/extracted/_futbin_*.html
KNOWLEDGE/extracted/_futbin_*.png
KNOWLEDGE/extracted/_futbin_*_probe.json
KNOWLEDGE/extracted/_futbin_xhr.json

# Large dataset CSVs — re-downloadable from Kaggle
KNOWLEDGE/extracted/EAFC26*.csv

# Raw player camera files (ARW/CR3/PNG source for _process.py). ~1.9GB.
# Only `processed/` outputs ship. Re-process locally when new photos drop.
KNOWLEDGE/brand-assets/players/*.ARW
KNOWLEDGE/brand-assets/players/*.CR3
KNOWLEDGE/brand-assets/players/*.png

# Plan 51 — v2 overlay public-asset mirror (regenerated by `npm run sync:overlays`)
# HTML files at apps/web/public/overlays/v2/<key>/index.html ARE committed
# (small, change-tracked). Bulk assets (fonts/logos/Orgs/players) are NOT.
apps/web/public/overlays/v2/_assets/
.env*.local
