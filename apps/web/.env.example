# Supabase project — Frontend (public) values
# Copy from Supabase dashboard → Settings → API → Project URL + Project API
# keys. Supabase ships two parallel naming schemes for the public key:
# - legacy `anon` JWT (NEXT_PUBLIC_SUPABASE_ANON_KEY)
# - new `publishable` key (NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY)
# Set whichever your project surfaces; the @supabase/ssr client accepts
# either as the second argument.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Supabase project — Server-side only (never expose to client)
# Settings → API → Project API keys → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Email transport. Without a key, new-device alerts print to stdout.
RESEND_API_KEY=
# RESEND_FROM="CADE League <noreply@yourdomain.com>"

# Application
APP_TIMEZONE=Africa/Lagos

# Futbin internal nation ID for Nigeria. Used by the squad validator
# (apps/web/src/server/squads/validate.ts → isNigerian()) so cards
# imported from futbin.com that have an `attributes.futbin_nation_id`
# but no `nation_iso` still count toward the Nigerian-in-XI rule.
# Confirmed empirically as 133 for FC26 via
# `node KNOWLEDGE/extracted/_find_futbin_nation_id.js` on 2026-05-01
# (~98% of rows labelled `nation='Nigeria'` in the DB carry this ID).
# Re-run the helper if Futbin's registry shifts in a future season.
NG_FUTBIN_NATION_ID=133

# Cron endpoints (Plan 6 scheduled announcements)
CRON_SECRET=generate-a-random-32-char-string

# Plan 14 — Stats screenshot OCR pipeline
# Anthropic Claude Opus 4.7 vision for parsing EAFC / FUT stat screens.
# In prod you MUST set ANTHROPIC_API_KEY and OCR_DISABLED=0.
# In dev default leave OCR_DISABLED=1 to exercise the manual-entry path.
ANTHROPIC_API_KEY=
OCR_DISABLED=1
OCR_DAILY_CAP_USD_CENTS=100

# Plan 44 — YouTube Data API v3 key for the live-chat picker + Feature-on-stream
# overlay. Surfaced inside the v1 broadcast panel, which is now orphaned
# behind the /admin/broadcast → /admin/broadcast/v2 redirect.
# Obtain via Google Cloud Console → APIs & Services → Credentials. Restrict
# to "YouTube Data API v3" for safety. See docs/ops/youtube-api-key.md.
# Without a key the panel surfaces "YOUTUBE_API_KEY is not configured".
YOUTUBE_API_KEY=

# Plan 39 hardening (2026-04-28) — ambient-session secret for the OBS /
# vMix browser-source bare URL `/api/broadcast/active-session`. Without
# the secret the endpoint returns only public IDs (no viewToken), so
# random unauthenticated callers can't unlock per-session overlay feeds.
# Operators bake `?secret=<value>` once into their browser-source URL.
# Generate a 32-char random string. Without this set, browser sources
# fall back to per-session URLs with `?t=<viewToken>` baked in.
BROADCAST_AMBIENT_SECRET=

# Plan 39 hardening (2026-04-28) — rate-limit infra. Provision Upstash
# Redis via Vercel Marketplace. The integration provisions vars under
# the KV_* prefix (KV_REST_API_URL + KV_REST_API_TOKEN); self-hosted
# Upstash exposes UPSTASH_REDIS_REST_*. lib/rate-limit.ts accepts
# either pair. Without these set the lib soft-fails to "always allow"
# so dev + CI keep working, but production MUST populate them or the
# auth 5-per-15-min lockout will not fire.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------
# Overlay Builder (Wave 1A+, spec 2026-05-17)
# Every flag defaults to false. Set the literal string 'true' to
# enable; anything else (TRUE, 1, yes) is treated as off. These are
# public (NEXT_PUBLIC_*) because the admin layout reads them client
# side to gate the route + sub-tab visibility.
# ---------------------------------------------------------------
NEXT_PUBLIC_OVERLAY_BUILDER_ENABLED=false
NEXT_PUBLIC_OVERLAY_BUILDER_PUBLISH_ENABLED=false
NEXT_PUBLIC_OVERLAY_BUILDER_PHOTOPEA_ENABLED=false
