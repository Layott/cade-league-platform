# Supabase project — Frontend (public) values
# Copy from Supabase dashboard → Settings → API → Project URL / anon public
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase project — Server-side only (never expose to client)
# Settings → API → Project API keys → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Email transport. Without a key, new-device alerts print to stdout.
RESEND_API_KEY=
# RESEND_FROM="CADE League <noreply@yourdomain.com>"

# Application
APP_TIMEZONE=Africa/Lagos

# Cron endpoints (Plan 6 scheduled announcements)
CRON_SECRET=generate-a-random-32-char-string

# Plan 14 — Stats screenshot OCR pipeline
# Anthropic Claude Opus 4.7 vision for parsing eFootball / FUT stat screens.
# In prod you MUST set ANTHROPIC_API_KEY and OCR_DISABLED=0.
# In dev default leave OCR_DISABLED=1 to exercise the manual-entry path.
ANTHROPIC_API_KEY=
OCR_DISABLED=1
OCR_DAILY_CAP_USD_CENTS=100
