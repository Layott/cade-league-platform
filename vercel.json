{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "cd apps/web && npm run build",
  "installCommand": "npm install",
  "outputDirectory": "apps/web/.next",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD ./apps/web ./KNOWLEDGE/brand-assets/elements/v2 ./KNOWLEDGE/brand-assets/logos ./KNOWLEDGE/brand-assets/Orgs ./KNOWLEDGE/brand-assets/players/processed ./KNOWLEDGE/brand-assets/fonts ./vercel.json",
  "headers": [
    {
      "source": "/overlays/v2/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0, must-revalidate" }
      ]
    }
  ],
  "crons": [
    { "path": "/api/cron/publish-announcements", "schedule": "*/5 * * * *" },
    { "path": "/api/cron/squad-deadline-check", "schedule": "0 * * * *" }
  ]
}
